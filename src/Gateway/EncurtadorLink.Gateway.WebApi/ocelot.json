{
  "GlobalConfiguration": {
    "BaseUrl": "https://gateway-encurtadorlink.azurewebsites.net",
    "RateLimitOptions": {
      "QuotaExceededMessage": "Limite de solicitacoes excedido, tente novamente mais tarde."
    }
  },
  "Routes": [
    {
      //Api - RecuperaLink
      //Entrada
      "UpstreamPathTemplate": "/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "PATCH", "DELETE" ],
      //Saída
      "DownstreamPathTemplate": "/{everything}",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "encurtador-link-api.azurewebsites.net",
          "Port": 443
        }
      ],
      //Limite de requisições
      "RateLimitOptions": {
        "ClientWhitelist": [],
        "EnableRateLimiting": true,
        "Period": "1s",
        "PeriodTimespan": 10,
        "Limit": 1
      },
      "SwaggerKey": "apiSwagger"
    }
  ],
  "SwaggerEndPoints": [
    {
      "Key": "apiSwagger",
      "Config": [
        {
          "Name": "Gateway: API - EncurtadorLink",
          "Version": "v1",
          "Url": "https://encurtador-link-api.azurewebsites.net/swagger/v1/swagger.json"
        }
      ]
    }
  ],
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information"
    }
  }
}
