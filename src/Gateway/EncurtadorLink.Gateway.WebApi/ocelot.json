{
  "GlobalConfiguration": {
    "BaseUrl": "https://gateway-encurtadorlink.azurewebsites.net",
    "RateLimitOptions": {
      "QuotaExceededMessage": "Limite de solicitacoes excedido, tente novamente mais tarde."
    }
  },
  "Routes": [
    {
      //Serviço RecuperaLink
      //Entrada
      "UpstreamPathTemplate": "/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ],
      //Saída
      "DownstreamPathTemplate": "/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "recuperalink.azurewebsites.net",
          "Port": 80
        }
      ],
      "SwaggerKey": "recuperaLinkApi",
      //Limite de requisições
      "RateLimitOptions": {
        "ClientWhitelist": [],
        "EnableRateLimiting": true,
        "Period": "10s",
        "PeriodTimespan": 10,
        "Limit": 2
      }
    }
  ],
  "SwaggerEndPoints": [
    {
      "Key": "recuperaLinkApi",
      "Config": [
        {
          "Name": "Gateway: API - RecuperaLink",
          "Version": "v1",
          "Url": "https://recuperalink.azurewebsites.net/swagger/v1/swagger.json"
        }
      ]
    }
  ],
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information"
    }
  }
}
