{
  "GlobalConfiguration": {
    "BaseUrl": "https://localhost:7246"
  },
  "Routes": [
    {
      //Serviço RecuperaLink
      //Entrada
      "UpstreamPathTemplate": "/gateway/recupera-link/{everything}",
      "UpstreamHttpMethod": [ "Get" ],
      //Saída
      "DownstreamPathTemplate": "/{everything}",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 7285
        }
      ],
      //Limite de requisições
      "RateLimitOptions": {
        "ClientWhitelist": [],
        "EnableRateLimiting": true,
        "Period": "1s",
        "PeriodTimespan": 10,
        "Limit": 50
      }
    }
  ]
}
